# These values are intentionally unpublished. A protected route returns 404 in
# production until its APPROVED flag is exactly "true" and both VERSION and
# TEXT (or EMAIL for support) are present. Keep these values server-only.

KELIMIO_SUPPORT_APPROVED=false
KELIMIO_SUPPORT_VERSION=
KELIMIO_SUPPORT_EMAIL=

KELIMIO_ACCOUNT_DELETION_APPROVED=false
KELIMIO_ACCOUNT_DELETION_VERSION=
KELIMIO_ACCOUNT_DELETION_TEXT=

KELIMIO_PRIVACY_APPROVED=false
KELIMIO_PRIVACY_VERSION=
KELIMIO_PRIVACY_TEXT=

KELIMIO_TERMS_APPROVED=false
KELIMIO_TERMS_VERSION=
KELIMIO_TERMS_TEXT=

KELIMIO_COMMUNITY_GUIDELINES_APPROVED=false
KELIMIO_COMMUNITY_GUIDELINES_VERSION=
KELIMIO_COMMUNITY_GUIDELINES_TEXT=

KELIMIO_TEACHER_TERMS_APPROVED=false
KELIMIO_TEACHER_TERMS_VERSION=
KELIMIO_TEACHER_TERMS_TEXT=
