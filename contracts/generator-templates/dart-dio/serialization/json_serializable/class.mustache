      runtimeType == other.runtimeType &&
      equals(
        [
          {{#vars}}
            {{{name}}},
          {{/vars}}
        ],
        [
          {{#vars}}
            other.{{{name}}},
          {{/vars}}
        ]
      );
    }
  {{/useEquatable}}

  {{^useEquatable}}
    @override
    bool operator ==(Object other) => identical(this, other) || other is {{{classname}}} &&
    {{#vars}}
      other.{{{name}}} == {{{name}}}{{^-last}} &&{{/-last}}{{#-last}};{{/-last}}
    {{/vars}}
  {{/useEquatable}}

  {{#useEquatable}}
    @override
    int get hashCode => runtimeType.hashCode ^ mapPropsToHashCode([
    {{#vars}}
        {{{name}}},
    {{/vars}}
    ],);
  {{/useEquatable}}
  {{^useEquatable}}
    @override
    int get hashCode =>
    {{#vars}}
