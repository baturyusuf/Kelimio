    {{/vendorExtensions.x-kelimio-sensitive}}
    {{/vars}}
    return json.toString();
  {{/vendorExtensions.x-kelimio-redacted-to-string}}
  {{^vendorExtensions.x-kelimio-redacted-to-string}}
    return toJson().toString();
  {{/vendorExtensions.x-kelimio-redacted-to-string}}
